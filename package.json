{
  "name": "ngx-translate-routes",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test:prod": "ng test ngx-translate-routes --code-coverage --watch=false --browsers=ChromeHeadlessNoSandbox",
    "lint": "ng lint ngx-translate-routes",
    "lint:prod": "ng lint ngx-translate-routes --fix",
    "lint:showcases": "ng lint ngx-translate-routes-showcase && ng lint ngx-translate-routes-ssr-showcase",
    "prepare": "husky",
    "update:changelog": "node scripts/update-changelog.mjs",
    "update:package-version": "node scripts/update-package-version.mjs",
    "update:readme": "node scripts/update-readme.mjs",
    "docs:start": "pnpm --prefix docs start",
    "docs:build": "pnpm --prefix docs build",
    "docs:serve": "pnpm --prefix docs serve",
    "docs:i18n": "pnpm --prefix docs write-translations -- --locale es"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@angular/platform-server": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@angular/ssr": "^22.1.4",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "bootstrap": "^4.4.1",
    "express": "^4.18.2",
    "ngx-translate-testing": "^6.0.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.3.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^19.2.0",
    "@angular-eslint/eslint-plugin": "^19.2.0",
    "@angular-eslint/eslint-plugin-template": "^19.2.0",
    "@angular-eslint/schematics": "^19.2.0",
    "@angular-eslint/template-parser": "^19.2.0",
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@angular/language-service": "^22.1.2",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~3.6.11",
    "@types/jasminewd2": "~2.0.13",
    "@types/node": "^18.18.0",
    "@vitest/browser": "^4.1.11",
    "auto-changelog": "^2.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.0.11",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.2",
    "jasmine-spec-reporter": "~5.0.2",
    "jsdom": "^30.0.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.1.1",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.2.5",
    "puppeteer": "^22.15.0",
    "semver": "^7.7.1",
    "ts-node": "~8.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.0.8"
  }
}
