{
  "name": "ngx-translate-routes",
  "version": "0.0.0",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve ngx-translate-routes-showcase",
    "start:ssr": "ng serve ngx-translate-routes-ssr-showcase",
    "build": "ng build",
    "test": "ng test",
    "test:prod": "ng test ngx-translate-routes --coverage --watch=false",
    "lint": "ng lint ngx-translate-routes",
    "lint:showcases": "ng lint ngx-translate-routes-showcase && ng lint ngx-translate-routes-ssr-showcase",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "update:readme": "node scripts/update-readme.mjs",
    "release": "semantic-release",
    "docs:start": "pnpm --prefix docs start",
    "docs:build": "pnpm --prefix docs build",
    "docs:serve": "pnpm --prefix docs serve",
    "docs:i18n": "pnpm --prefix docs write-translations -- --locale es"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@angular/platform-server": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@angular/ssr": "^22.1.4",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "bootstrap": "^4.4.1",
    "express": "^4.18.2",
    "ngx-translate-testing": "^6.0.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.3.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/schematics": "^22.5.0",
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@angular/language-service": "^22.1.2",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.39.5",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/express": "^4.17.17",
    "@types/node": "^18.18.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.0.11",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.4.0",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.2.5",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.0.8"
  }
}
